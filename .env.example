TAVILY_API_KEY=
GROQ_API_KEY=

# Optional — Langfuse tracing. Without both keys, tracing silently no-ops and the
# app behaves exactly as before. https://cloud.langfuse.com → Settings → API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Only needed for the EU region (https://cloud.langfuse.com is US) or self-hosting.
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set to 0 to disable tracing even when keys are present.
# LANGFUSE_TRACING=1
